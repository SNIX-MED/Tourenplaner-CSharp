                                        <Image Width="34" Height="34" VerticalAlignment="Center" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" Source="/Tourenplaner.CSharp.App;component/Assets/RouteOverview/Ladegewicht.png" />
                                        <Border Grid.Column="1" Width="1" Height="40" VerticalAlignment="Center" Background="{DynamicResource Brush.BorderSoft}" />
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Ladegewicht" /><TextBlock Margin="0,1,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourCapacityValueText}" /></StackPanel>
