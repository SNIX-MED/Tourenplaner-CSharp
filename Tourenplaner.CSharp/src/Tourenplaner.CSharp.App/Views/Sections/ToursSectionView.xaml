                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Width="6"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="{DynamicResource Brush.BorderSoft}" />

            <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource FlatCardStyle}" Padding="12" Effect="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedTour.Name, TargetNullValue=Keine Tour ausgewählt}" />
                                    <Border Margin="10,0,0,0" Padding="9,3" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding SelectedTourStatusText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding SelectedTourTimeText}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#B45309"
                                           Text="{Binding SelectedTourMapLockText}"
                                           Visibility="{Binding IsSelectedTourLockedByMap, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="6" Margin="0,10,-6,-6">
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Stopps" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTour.StopCount, TargetNullValue=0}" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Strecke" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourDistanceText}" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Gesamtdauer" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourDurationText}" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Aufenthaltszeit" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourServiceTimeText}" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Wartezeit" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourWaitTimeText}" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Gesamtgewicht" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourTotalWeightValueText}" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Ladegewicht" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourCapacityValueText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTourLoadSummaryText}" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="WEBFLEET" /><TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Text="{Binding SelectedTourWebfleetText}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                            <Border MinHeight="62" Margin="0,0,6,6" Padding="12,9" CornerRadius="12" Background="{DynamicResource Brush.CardSoft}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Fahrzeug &amp; Anhänger" /><TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="Bold" Text="{Binding SelectedTourVehicleAssignmentText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTourVehicleAssignmentText}" /></StackPanel></Border>
                        </UniformGrid>

                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedTourWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,5" Padding="9,7" CornerRadius="9" BorderThickness="1" BorderBrush="#F59E0B" Background="#FFFFF7E6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Foreground="#B45309" Text="&#xE7BA;" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Foreground="#8A4B08" Text="{Binding Title}" />
                                                <TextBlock Foreground="#8A4B08" TextWrapping="Wrap" Text="{Binding Message}" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Text="{Binding Suggestion}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="11" HorizontalAlignment="Right" Background="{DynamicResource Brush.AccentSoft}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDragPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="Drag Vorschau" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               Text="{Binding DragPreviewEtaText}" />
                                    <TextBlock Margin="0,1,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding DragPreviewDurationText}" />
                                    <TextBlock Margin="0,1,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding DragPreviewDistanceText}" />
                                </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Brush.BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Background="{DynamicResource Brush.TableBackground}"
                            Padding="12"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType"
                            RenderOptions.ClearTypeHint="Enabled">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ListBox x:Name="SelectedTourStopsGrid"
                                     ItemsSource="{Binding SelectedTourStops}"
                                     SelectedItem="{Binding SelectedTourStop, Mode=TwoWay}"
                                     AllowDrop="True"
                                     ContextMenuOpening="OnSelectedTourStopContextMenuOpening"
                                     PreviewMouseLeftButtonDown="SelectedTourStopsGrid_PreviewMouseLeftButtonDown"
                                     PreviewMouseRightButtonDown="SelectedTourStopsGrid_PreviewMouseRightButtonDown"
                                     MouseDoubleClick="SelectedTourStopsGrid_MouseDoubleClick"
                                     MouseMove="SelectedTourStopsGrid_MouseMove"
                                     DragOver="SelectedTourStopsGrid_DragOver"
                                     DragLeave="SelectedTourStopsGrid_DragLeave"
                                     Drop="SelectedTourStopsGrid_Drop"
                                     UseLayoutRounding="True"
                                     SnapsToDevicePixels="True"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     RenderOptions.ClearTypeHint="Enabled"
                                     Style="{StaticResource TourStopCardsListStyle}"
                                     ItemContainerStyle="{StaticResource TourStopCardListItemStyle}">
                                <ListBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 Style="{StaticResource QuickActionsContextMenuStyle}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="Separator">
                                                <Setter Property="Margin" Value="8,4" />
                                                <Setter Property="Background" Value="{DynamicResource Brush.BorderSoft}" />
                                            </Style>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="Aufenthaltszeit ändern"
                                                  Style="{StaticResource QuickActionsMenuItemStyle}"
                                                  Click="OnSelectedTourStopEditStayMenuItemClick" />
                                        <MenuItem Header="Pause danach einfügen"
                                                  Style="{StaticResource QuickActionsMenuItemStyle}"
                                                  Click="OnSelectedTourStopAddPauseMenuItemClick" />
                                        <MenuItem Header="Stopp entfernen"
                                                  Style="{StaticResource QuickActionsMenuItemStyle}"
                                                  Foreground="{DynamicResource Brush.Danger}"
                                                  Click="OnSelectedTourStopRemoveMenuItemClick" />
                                        <Separator />
                                        <MenuItem Header="Auftrag bearbeiten"
                                                  Click="OnSelectedTourStopEditOrderMenuItemClick">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource QuickActionsMenuItemStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTourStop.IsPauseStop}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14"
                                                BorderThickness="1"
                                                Margin="0,0,0,10"
                                                UseLayoutRounding="True"
                                                SnapsToDevicePixels="True"
                                                TextOptions.TextFormattingMode="Display"
                                                TextOptions.TextRenderingMode="ClearType"
                                                RenderOptions.ClearTypeHint="Enabled">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SoftCardStyle}">
                                                    <Setter Property="Padding" Value="12" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
                                                    <Setter Property="Effect" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRouteStart}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#7BC6A4" />
                                                            <Setter Property="Background" Value="#F2FBF6" />
                                                            <Setter Property="Padding" Value="4,2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRouteEnd}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#8EC6E8" />
                                                            <Setter Property="Background" Value="#F2F9FF" />
                                                            <Setter Property="Padding" Value="4,2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsArchivedOrder}" Value="True">
                                                            <Setter Property="Opacity" Value="0.48" />
                                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                            <Setter Property="Background" Value="#F8FAFC" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPauseStop}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="38"
                                                        Height="38"
                                                        CornerRadius="19"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Center"
                                                        Background="#4EBA74">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Order}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <TextBlock Text="{Binding Order}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Visibility="Collapsed">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Margin" Value="8,0,6,0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                    <Setter Property="Margin" Value="2,0,4,0" />
                                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="17" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                        <Setter Property="FontSize" Value="17" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Address}"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="{Binding Window, StringFormat=Zeitfenster: {0}}"
                                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                                        <TextBlock Text="  |  "
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                                        <TextBlock Text="{Binding Departure, StringFormat=Abfahrt: {0}}"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    </StackPanel>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPauseStop}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <Border Margin="0,0,6,4" Padding="7,3" CornerRadius="8" Background="{DynamicResource Brush.CardMuted}">
                                                            <TextBlock FontSize="11" Text="{Binding DeliveryType}" />
                                                        </Border>
                                                        <Border Margin="0,0,6,4" Padding="7,3" CornerRadius="8" Background="{DynamicResource Brush.CardMuted}">
                                                            <TextBlock FontSize="11" Text="{Binding ServiceTimeText}" />
                                                        </Border>
                                                        <Border Margin="0,0,6,4" Padding="7,3" CornerRadius="8" Background="{DynamicResource Brush.CardMuted}">
                                                            <TextBlock FontSize="11" Text="{Binding Weight}" />
                                                        </Border>
                                                        <Border Margin="0,0,6,4" Padding="7,3" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding PinStatusText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Accent}" Text="{Binding PinStatusText}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <Border Margin="0,2,0,0" Padding="8,5" CornerRadius="8" Background="#FFF5ECFA">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Text="{Binding NotesPreview, StringFormat=Notiz: {0}}" />
                                                    </Border>
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Text="{Binding Conflict}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasConflict}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTime}"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="18" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                        <Setter Property="FontSize" Value="18" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ArrivalRangeText}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.TextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ArrivalRangeText}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.TextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Ankunft" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRouteStart}" Value="True">
                                                                        <Setter Property="Text" Value="Start" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsRouteEnd}" Value="True">
                                                                        <Setter Property="Text" Value="Ende" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCompanyStop}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPauseStop}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Border Background="#FFF7E8"
                                                            BorderBrush="#F5C66B"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,3">
                                                        <TextBlock Text="Pause"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#8A5A00" />
                                                    </Border>
                                                    <TextBlock Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding PauseDurationText}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding PauseTimeRangeText}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                            </Grid>
                                        </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Width="220" Orientation="Vertical">
                            <Button Height="36"
                                    Margin="0,0,0,8"
                                    Content="Route neu berechnen"
                                    ToolTip="Öffnet die ausgewählte Tour im Karten-Tab und berechnet sie dort mit den aktuellen Routing-Einstellungen neu."
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RecalculateCommand}" />
                            <Button Height="36"
                                    Margin="0,0,0,8"
                                    Content="Weitere Aktionen  ···"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnTourMoreActionsClicked">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource QuickActionsContextMenuStyle}">
                                        <MenuItem Header="Tour auf Karte anzeigen" Style="{StaticResource QuickActionsMenuItemStyle}" Command="{Binding PlacementTarget.DataContext.OpenTourOnMapCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Tour bearbeiten" Style="{StaticResource QuickActionsMenuItemStyle}" Command="{Binding PlacementTarget.DataContext.EditTourOnMapCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{Binding PlacementTarget.DataContext.ToggleArchiveTourButtonText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource QuickActionsMenuItemStyle}" Command="{Binding PlacementTarget.DataContext.ToggleArchiveTourCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Tour löschen" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource QuickActionsMenuItemStyle}" Command="{Binding PlacementTarget.DataContext.DeleteTourCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Padding="16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource FlatCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowCalendarLayout}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button
                                Padding="14,6"
                                Content="{Binding LayoutToggleButtonText}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleLayoutCommand}" />
                        <Border Margin="14,0,0,0"
                                Padding="8,3"
                                CornerRadius="10"
                                Background="{DynamicResource Brush.SurfaceAlt}">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Text="{Binding FilterInfoText}" />
                        </Border>
                    </StackPanel>

                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Tours}"
                             SelectedItem="{Binding SelectedTour, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CalendarTourCardItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="360"
                                        Padding="10"
                                        MouseLeftButtonDown="OnTourCalendarCardMouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource FlatCardStyle}">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           Text="{Binding Date}" />
                                                <TextBlock FontWeight="SemiBold"
                                                           FontSize="16"
                                                           Text="{Binding Name}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="36"
                                                    Height="36"
                                                    Margin="8,0,6,0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Tour auf Karte anzeigen"
                                                    Click="OnOpenCalendarTourOnMapClicked">
                                                <Image Width="24"
                                                       Height="24"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       SnapsToDevicePixels="True"
                                                       Source="pack://application:,,,/Tourenplaner.CSharp.App;component/Assets/Pin.png" />
                                            </Button>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       Text="{Binding Start}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,6,0,8"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Text="{Binding CalendarSummary}" />

                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarStops}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8"
                                                            Style="{StaticResource SoftCardStyle}"
                                                            Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="36"
                                                                    Height="36"
                                                                    CornerRadius="18"
                                                                    Background="#4EBA74"
                                                                    VerticalAlignment="Top"
                                                                    HorizontalAlignment="Left">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="16"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           Text="{Binding StopLetter}" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                                <TextBlock FontSize="17"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding DeliveryAddress}" />
                                                                <TextBlock FontSize="11"
                                                                           Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding OrderAddress}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}"
                                                                               Text="{Binding WindowText, StringFormat=Zeitfenster: {0}}" />
                                                                    <TextBlock Margin="8,0,0,0"
                                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                                               Text="|" />
                                                                    <TextBlock Margin="8,0,0,0"
                                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                                               Text="{Binding DepartureText, StringFormat=Abfahrt: {0}}" />
                                                                </StackPanel>
                                                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ProductLines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock FontSize="12"
                                                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                                                       TextWrapping="Wrap"
                                                                                       Text="{Binding}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Margin="0,6,0,0"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                                           Text="{Binding WeightText}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock HorizontalAlignment="Right"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="18"
                                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                                           Text="{Binding DisplayTime}" />
                                                                <TextBlock HorizontalAlignment="Right"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                                           Text="{Binding ArrivalRangeText}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ArrivalRangeText}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock HorizontalAlignment="Right"
                                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                                           Text="{Binding TimeLabel}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
