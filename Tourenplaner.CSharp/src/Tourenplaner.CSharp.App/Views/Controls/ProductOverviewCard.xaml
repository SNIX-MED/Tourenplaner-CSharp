<UserControl x:Class="Tourenplaner.CSharp.App.Views.Controls.ProductOverviewCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{Binding BackgroundColor, ElementName=Root}" />
                <Setter Property="BorderBrush" Value="{Binding BorderColor, ElementName=Root}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        <Setter Property="BorderThickness" Value="3" />
                        <Setter Property="Padding" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontWeight="SemiBold"
                           Text="{Binding Title, ElementName=Root}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{Binding BorderColor, ElementName=Root}"
                           Text="{Binding DeliveryStatus, ElementName=Root}" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0">
                    <StackPanel Margin="0,0,18,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExpectedDelivery, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="5" Height="5" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" />
                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{Binding ExpectedDelivery, ElementName=Root, StringFormat=Lieferung erwartet: {0}}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,18,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDimensions, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="5" Height="5" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" />
                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{Binding DimensionsLine, ElementName=Root}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,18,0" Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" />
                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding WeightLine, ElementName=Root}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}" />
                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding TotalLine, ElementName=Root}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSupplier, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Supplier, ElementName=Root}" />
                </TextBlock>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
