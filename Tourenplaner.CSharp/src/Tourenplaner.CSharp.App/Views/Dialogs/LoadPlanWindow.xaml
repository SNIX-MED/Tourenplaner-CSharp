<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.LoadPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tourenplaner.CSharp.App.Views.Dialogs"
        Title="Ladeplan"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}">
    <Window.Resources>
        <Style x:Key="LoadPlanContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Popup.AllowsTransparency" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="3" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" ClipToBounds="True" SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoadPlanMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.CardMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="26" FontWeight="Bold" Text="Ladeplan" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding TourName}" />
            </StackPanel>
            <Border Grid.Column="2" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="10" Background="{DynamicResource Brush.AccentSurface}">
                <TextBlock x:Name="ProductSummaryText" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding ProductSummary}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" Style="{StaticResource FlatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Produkte der Tour" />
                        <Button Grid.Column="1" Height="32" Padding="11,0" Content="Zusatzmaterial wählen"
                                Click="OnSelectAdditionalMaterialClick" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Orders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="8" CornerRadius="9"
                                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                                            Background="{DynamicResource Brush.Card}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <local:LoadPlanStopMarkerControl Width="24" Height="24" HorizontalAlignment="Left"
                                                                                 Letter="{Binding StopLetter}" Shape="{Binding MarkerShape}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="Bold" Text="{Binding OrderHeading}" />
                                                    <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                                               Text="{Binding Address}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Products}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,1" Padding="4,3" CornerRadius="6"
                                                                PreviewMouseLeftButtonDown="OnProductPreviewMouseLeftButtonDown"
                                                                MouseLeftButtonDown="OnProductMouseLeftButtonDown"
                                                                MouseMove="OnProductMouseMove">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInPackage}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                                            <Setter Property="BorderBrush" Value="#22C55E" />
                                                                            <Setter Property="Cursor" Value="Arrow" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      IsChecked="{Binding IsSelectedForPackage}"
                                                                      IsEnabled="{Binding CanSelectForPackage}" />
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                       FontWeight="SemiBold" Text="{Binding UnitText}" />
                                                            <StackPanel Grid.Column="2" Margin="4,0,6,0">
                                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="34" />
                                                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding CompactDimensions}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding WeightText}" />
                                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Packages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <Border Margin="0,2" Padding="4" CornerRadius="6" Background="#ECFDF5"
                                                                    BorderBrush="#16A34A" BorderThickness="1"
                                                                    PreviewMouseLeftButtonDown="OnProductPreviewMouseLeftButtonDown" MouseMove="OnProductMouseMove">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <Button Width="22" Height="22" Padding="0" Content="{Binding ExpandGlyph}"
                                                                            Click="OnTogglePackageClick" Style="{StaticResource SecondaryButtonStyle}" />
                                                                    <Grid Grid.Column="1" Margin="4,0">
                                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                                        <TextBlock FontWeight="Bold" Foreground="#166534" Text="{Binding Heading}" />
                                                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                                            <TextBlock FontSize="10" Text="{Binding Dimensions}" />
                                                                            <TextBlock Margin="6,0,0,0" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding ProductSummary}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Button Grid.Column="2" Width="26" Height="26" Padding="0" Content="⋯"
                                                                            Click="OnPackageMenuClick" Style="{StaticResource SecondaryButtonStyle}">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu Placement="Bottom" Style="{StaticResource LoadPlanContextMenuStyle}">
                                                                                <MenuItem Header="Bearbeiten" Click="OnEditPackageClick"
                                                                                          Style="{StaticResource LoadPlanMenuItemStyle}"
                                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                                <MenuItem Header="Auflösen" Click="OnDissolvePackageClick" Foreground="{DynamicResource Brush.Danger}"
                                                                                          Style="{StaticResource LoadPlanMenuItemStyle}"
                                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                            <ItemsControl Margin="28,0,0,2" ItemsSource="{Binding Products}">
                                                                <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,1" MouseLeftButtonDown="OnProductMouseLeftButtonDown">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding UnitText}" />
                                                                            <TextBlock Grid.Column="1" FontSize="10" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Column="2" FontSize="10" Text="{Binding WeightText}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedProducts}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding PackageActionText}" />
                                                <Button Grid.Column="1" Padding="8,3" Content="Packstück erstellen" Click="OnCreatePackageClick"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                            <TextBlock Margin="0,7,0,0" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"
                                                       Text="Keine Produkte vorhanden">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander x:Name="AdditionalMaterialsExpander" Margin="0,8,0,0" IsExpanded="True" Visibility="{Binding AdditionalMaterialsVisibility}">
                            <Expander.Header>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Zusatzmaterial" />
                            </Expander.Header>
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding AdditionalMaterials}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5" Padding="7" CornerRadius="8"
                                                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="OnProductPreviewMouseLeftButtonDown"
                                                MouseLeftButtonDown="OnProductMouseLeftButtonDown"
                                                MouseMove="OnProductMouseMove">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                            <Setter Property="BorderBrush" Value="#22C55E" />
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <local:LoadPlanStopMarkerControl Width="24" Height="24" Letter="Z" Shape="square" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding UnitText}" />
                                                <StackPanel Grid.Column="2" Margin="4,0,6,0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding CompactDimensions}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding WeightText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                      </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="18" Style="{StaticResource FlatCardStyle}">
                <Grid>
                    <local:LoadPlanSurfaceControl x:Name="LoadPlanSurface" ClipToBounds="True" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                            Padding="4" CornerRadius="9" Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Width="34" Height="32" Padding="0" Content="−" FontSize="18"
                                    ToolTip="Verkleinern" Click="OnZoomOutClick"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <TextBlock x:Name="ZoomLevelText" Width="58" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       FontWeight="SemiBold" Text="100 %" />
                            <Button Width="34" Height="32" Padding="0" Content="+" FontSize="18"
                                    ToolTip="Vergrößern" Click="OnZoomInClick"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Height="32" Margin="5,0,0,0" Padding="10,0" Content="Einpassen"
                                    ToolTip="Fahrzeug und Anhänger vollständig anzeigen"
                                    Click="OnFitViewClick" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="140" Content="Abbrechen" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="160" Margin="10,0,0,0" Content="Ladeplan speichern" Click="OnSaveClick"
                    Style="{StaticResource SuccessButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
