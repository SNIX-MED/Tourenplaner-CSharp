<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.EmployeeEditorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tourenplaner.CSharp.App.Views.Controls"
        Title="Mitarbeiter"
        Width="540"
        Height="760"
        MinHeight="520"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Border Margin="10" Style="{StaticResource FlatCardStyle}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="34" FontWeight="Bold" Text="Mitarbeiter" />
                <Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTip="Als Favorit markieren"
                        Click="OnFavoriteClicked">
                    <TextBlock FontSize="24"
                               Text="&#x2605;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Foreground" Value="#D4A017" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock FontWeight="SemiBold" Text="Name *" />
                <TextBox Margin="0,6,0,0"
                         Height="38"
                         ToolTip="Name"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock FontWeight="SemiBold" Text="Kürzel" />
                <TextBox Margin="0,6,0,0"
                         Height="38"
                         ToolTip="Kürzel"
                         Text="{Binding ShortCode, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock FontWeight="SemiBold" Text="Telefon" />
                <TextBox Margin="0,6,0,0"
                         Height="38"
                         ToolTip="Telefon"
                         PreviewTextInput="PhoneTextBox_PreviewTextInput"
                         DataObject.Pasting="PhoneTextBox_OnPasting"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <CheckBox Content="Programmprofil aktivieren (Benutzer-Auswahl)"
                          IsChecked="{Binding HasProgramProfile}" />
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="WEBFLEET-Gerät" />
                <ComboBox Margin="0,6,0,0"
                          Height="38"
                          IsEnabled="{Binding IsWebfleetEnabled}"
                          ItemsSource="{Binding WebfleetVehicles}"
                          SelectedItem="{Binding SelectedWebfleetVehicle, Mode=TwoWay}"
                          ToolTip="WEBFLEET-Objekt auswählen">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#B45309"
                           TextWrapping="Wrap"
                           Text="Doppelte WEBFLEET-Zuordnung erkannt. Diese Zuordnung wird beim Speichern entfernt.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDuplicateWebfleetAssignment}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="{Binding NoWebfleetVehiclesMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvailableWebfleetVehicles}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="WEBFLEET-Fahrer" />
                <ComboBox Margin="0,6,0,0"
                          Height="38"
                          IsEnabled="{Binding IsWebfleetEnabled}"
                          ItemsSource="{Binding WebfleetDrivers}"
                          SelectedItem="{Binding SelectedWebfleetDriver, Mode=TwoWay}"
                          ToolTip="WEBFLEET-Fahrer auswählen">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="{Binding NoWebfleetDriversMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvailableWebfleetDrivers}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Abwesenheiten" />
                    <Button Grid.Column="1" Height="32" Padding="12,0" Content="Verwalten..." Click="OnManageAbsencesClicked" />
                </Grid>
                <Grid Margin="0,7,0,0">
                    <Grid>
                    <TextBlock HorizontalAlignment="Center" Margin="8" Foreground="{DynamicResource Brush.TextMuted}" Text="Keine Abwesenheiten eingetragen">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UnavailabilityItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UnavailabilityItems}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="0,0,0,5" Padding="10,8" CornerRadius="8"
                                        Background="White" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="4" Margin="0,1,10,1" CornerRadius="2" Background="{DynamicResource Brush.Accent}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DateRangeText}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding TimeRangeText}" />
                                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding NoteText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="110"
                        Height="40"
                        Margin="0,0,12,0"
                        Content="Löschen"
                        Style="{StaticResource DangerOutlineButtonStyle}"
                        Visibility="{Binding HasExistingEntry, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="OnDeleteClicked" />

                <Button Grid.Column="2"
                        Width="120"
                        Height="40"
                        Margin="0,0,8,0"
                        Content="Abbrechen"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCancelClicked" />

                <Button Grid.Column="3"
                        Width="120"
                        Height="40"
                        Content="Speichern"
                        Style="{StaticResource SuccessButtonStyle}"
                        IsDefault="True"
                        Click="OnSaveClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
