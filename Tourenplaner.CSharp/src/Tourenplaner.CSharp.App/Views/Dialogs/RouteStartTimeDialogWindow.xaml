<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.RouteStartTimeDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abfahrtszeit ändern"
        Width="400"
        Height="300"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Style="{StaticResource FlatCardStyle}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Abfahrtszeit ändern" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Text="Die Tourzeiten werden anschließend neu berechnet." />

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="Stunde" />
                    <ComboBox x:Name="HourComboBox"
                              Margin="0,5,0,0"
                              Height="34" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Minute" />
                    <ComboBox x:Name="MinuteComboBox"
                              Margin="0,5,0,0"
                              Height="34" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="Abbrechen"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCancelClicked" />
                <Button Grid.Column="1"
                        Height="34"
                        Margin="8,0,0,0"
                        Content="Übernehmen"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="OnApplyClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
