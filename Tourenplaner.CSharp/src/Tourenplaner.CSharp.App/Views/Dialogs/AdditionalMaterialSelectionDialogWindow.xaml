<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.AdditionalMaterialSelectionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zusatzmaterial auswählen" Width="560" Height="520" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Padding="18" Style="{StaticResource FlatCardStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="Zusatzmaterial auswählen"/>
                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="Materialgruppen für diese Tour festlegen."/>
                </StackPanel>
                <Button Grid.Column="1" Height="36" Padding="14,0" Content="Zusatzmaterial verwalten"
                        Click="OnManage" Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>
            <ListBox Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding Options}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,7"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="MaterialCard" Padding="12,10" CornerRadius="9" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1" Background="{DynamicResource Brush.Card}">
                            <CheckBox HorizontalContentAlignment="Stretch" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold" Text="{Binding WeightKg, StringFormat={}{0:0.##} kg}"/></Grid>
                            </CheckBox>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="MaterialCard" Property="BorderBrush" Value="#990099"/>
                                <Setter TargetName="MaterialCard" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="MaterialCard" Property="Background" Value="#F8ECF8"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><Button Grid.Column="1" Height="38" Margin="0,0,7,0" Content="Abbrechen" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="2" Height="38" Margin="7,0,0,0" Content="Übernehmen" IsDefault="True" Click="OnSave" Style="{StaticResource SuccessButtonStyle}"/></Grid>
        </Grid>
    </Border>
</Window>
