<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.WebfleetDriverSelectionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WEBFLEET-Fahrer wählen" Width="460" Height="270"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="14" Padding="18" Style="{StaticResource FlatCardStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock FontSize="25" FontWeight="Bold" Text="WEBFLEET-Fahrer wählen" />
            <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Text="Mehrere Mitarbeitende dieser Tour besitzen ein zugeordnetes WEBFLEET-Gerät. Wähle das Gerät, an das die Tour gesendet werden soll." />
            <ComboBox Grid.Row="2" Margin="0,18,0,0" Height="38" ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}" DisplayMemberPath="Label" />
            <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Height="38" Margin="0,0,8,0" Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClicked" />
                <Button Width="110" Height="38" Content="Senden" Style="{StaticResource SuccessButtonStyle}" Click="OnSendClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
