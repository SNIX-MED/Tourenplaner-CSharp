<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.AdditionalMaterialItemDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Position bearbeiten" Width="560" Height="350" MinWidth="500" MinHeight="330"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Padding="18" Style="{StaticResource FlatCardStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Position bearbeiten"/>
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Bezeichnung"/>
                <TextBox Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Menge"/>
                        <TextBox Height="38" Padding="10,0" VerticalContentAlignment="Center"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Gewicht pro Stück"/>
                        <Grid><TextBox Height="38" Padding="10,0,34,0" VerticalContentAlignment="Center" Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" Text="kg"/></Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Height="38" Margin="0,0,7,0" Content="Abbrechen" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Grid.Column="2" Height="38" Margin="7,0,0,0" Content="Übernehmen" IsDefault="True" Click="OnSave" Style="{StaticResource SuccessButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
