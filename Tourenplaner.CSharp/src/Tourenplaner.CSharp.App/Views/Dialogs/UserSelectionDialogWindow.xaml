<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.UserSelectionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benutzer auswählen"
        Width="420"
        SizeToContent="Height"
        MinHeight="310"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Style="{StaticResource FlatCardStyle}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="28"
                       FontWeight="Bold"
                       Text="Benutzer anmelden" />

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       TextWrapping="Wrap"
                       Text="{Binding Instructions}" />

            <TextBlock Grid.Row="2"
                       Margin="0,16,0,0"
                       FontWeight="SemiBold"
                       Text="Benutzerprofil" />

            <ComboBox Grid.Row="3"
                      Visibility="{Binding SelectionVisibility}"
                      Margin="0,6,0,0"
                      Height="38"
                      ItemsSource="{Binding UserNames}"
                      SelectedItem="{Binding SelectedUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox Grid.Row="3"
                     Visibility="{Binding CreationVisibility}"
                     Margin="0,6,0,0"
                     Height="38"
                     Text="{Binding SelectedUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Row="4"
                    Height="40"
                    Margin="0,16,0,0"
                    Content="Login"
                    Style="{StaticResource SuccessButtonStyle}"
                    IsDefault="True"
                    Click="OnConfirmClicked" />
        </Grid>
    </Border>
</Window>
