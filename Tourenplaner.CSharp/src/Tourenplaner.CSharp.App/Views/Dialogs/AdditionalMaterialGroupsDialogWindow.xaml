<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.AdditionalMaterialGroupsDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zusätzliches Material verwalten"
        Width="900" Height="620" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Padding="16" Style="{StaticResource FlatCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="Bold" Text="Zusätzliches Material" />
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="Werkzeuggruppen für die Tourplanung verwalten" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="12" Style="{StaticResource SoftCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Werkzeuggruppen" />
                        <ListBox x:Name="GroupsList" Grid.Row="1" Margin="0,10" ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup}" BorderThickness="0"
                                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="GroupCard" Padding="11,9" CornerRadius="10"
                                            Background="{DynamicResource Brush.SurfaceRaised}"
                                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,3" CornerRadius="999"
                                                    Background="{DynamicResource Brush.WindowBackground}">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DisplayWeightText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="GroupCard" Property="BorderBrush" Value="#990099" />
                                            <Setter TargetName="GroupCard" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="GroupCard" Property="Background" Value="#F8ECF8" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="36" MinWidth="170" Padding="14,0" Content="Gruppe hinzufügen"
                                    Click="OnAddGroup" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Grid.Column="1" Height="36" MinWidth="90" Margin="8,0,0,0" Padding="12,0"
                                    Content="Entfernen" Click="OnRemoveGroup" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="14" Style="{StaticResource SoftCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Gruppe bearbeiten" />
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Name" />
                                <TextBox Height="36" Padding="9,5" Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Gesamtgewicht (kg)" />
                                <TextBox Height="36" Padding="9,5" ToolTip="Leer lassen, um die Gewichte der Positionen zu summieren."
                                         Text="{Binding SelectedGroup.TotalWeightText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Positionen / Werkzeuge" />
                            <DataGrid x:Name="ItemsGrid" Grid.Row="1" Margin="0,6,0,0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      ItemsSource="{Binding SelectedGroup.Items}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Header="Bezeichnung" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="135" Header="Gewicht (kg)" Binding="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Height="36" MinWidth="155" Padding="12,0" Content="Position hinzufügen"
                                    Click="OnAddItem" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Height="36" MinWidth="155" Margin="8,0,0,0" Padding="12,0" Content="Position entfernen"
                                    Click="OnRemoveItem" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Height="38" Margin="0,0,8,0" Padding="14,0" Content="Abbrechen"
                        IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="2" Height="38" Margin="8,0,0,0" Padding="14,0" Content="Übernehmen"
                        IsDefault="True" Click="OnSave" Style="{StaticResource SuccessButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
