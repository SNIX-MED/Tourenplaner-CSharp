<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.AdditionalMaterialGroupsDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zusätzliches Material verwalten"
        Width="1220" Height="660" MinWidth="1040" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Padding="16" Style="{StaticResource FlatCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="Bold" Text="Zusätzliches Material" />
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="Werkzeuggruppen für die Tourplanung verwalten" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="12" Style="{StaticResource SoftCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Werkzeuggruppen" />
                        <ListBox x:Name="GroupsList" Grid.Row="1" Margin="0,10" ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup}" BorderThickness="0"
                                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="GroupCard" Padding="11,9" CornerRadius="10"
                                            Background="{DynamicResource Brush.SurfaceRaised}"
                                            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding PositionSummary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold" Text="{Binding DisplayWeightText}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="GroupCard" Property="BorderBrush" Value="#990099" />
                                            <Setter TargetName="GroupCard" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="GroupCard" Property="Background" Value="#F8ECF8" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="36" MinWidth="170" Padding="14,0" Content="Gruppe hinzufügen"
                                    Click="OnAddGroup" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Grid.Column="1" Height="36" MinWidth="90" Margin="8,0,0,0" Padding="12,0"
                                    Content="Entfernen" Click="OnRemoveGroup" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="14" Style="{StaticResource SoftCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Gruppe bearbeiten" />
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Name" />
                                <TextBox Height="36" Padding="9,5" Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Margin="0,8,0,0" FontWeight="SemiBold" Content="Benötigt Platz auf der Ladefläche"
                                          IsChecked="{Binding SelectedGroup.RequiresLoadingSpace}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGroup.RequiresLoadingSpace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Margin="0,0,0,4" Text="Breite"/><Grid><TextBox Height="36" Padding="9,5,34,5" Text="{Binding SelectedGroup.WidthText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" Text="mm"/></Grid></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,4" Text="Tiefe"/><Grid><TextBox Height="36" Padding="9,5,34,5" Text="{Binding SelectedGroup.DepthText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" Text="mm"/></Grid></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Margin="0,0,0,4" Text="Höhe (optional)"/><Grid><TextBox Height="36" Padding="9,5,34,5" Text="{Binding SelectedGroup.HeightText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" Text="mm"/></Grid></StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Gesamtgewicht überschreiben" />
                                <CheckBox Content="Manuell festlegen" IsChecked="{Binding SelectedGroup.UseManualTotalWeight}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGroup.UseManualTotalWeight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <TextBox Height="36" Padding="9,5,30,5" ToolTip="Leer lassen, um Menge × Stückgewicht automatisch zu summieren."
                                             Text="{Binding SelectedGroup.TotalWeightText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" Text="kg" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Positionen / Werkzeuge" />
                                <Button Grid.Column="1" Height="32" Padding="12,0" Content="+ Position" Click="OnAddItem" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Column="2" Height="32" Margin="7,0,0,0" Padding="12,0" Content="Bearbeiten" Click="OnEditItem" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="3" Height="32" Margin="7,0,0,0" Padding="12,0" Content="Entfernen" Click="OnRemoveItem" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <ListBox x:Name="ItemsGrid" Grid.Row="1" Margin="0,7,0,0" BorderThickness="0" Background="Transparent"
                                     ItemsSource="{Binding SelectedGroup.Items}" SelectedItem="{Binding SelectedGroup.SelectedItem}"
                                     MouseDoubleClick="OnItemDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,5"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemCard" Padding="10,8" CornerRadius="9" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1" Background="{DynamicResource Brush.Card}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding QuantitySummary}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding WeightSummary}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="#990099"/>
                                                <Setter TargetName="ItemCard" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="ItemCard" Property="Background" Value="#F8ECF8"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Height="38" Margin="0,0,8,0" Padding="14,0" Content="Abbrechen"
                        IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="2" Height="38" Margin="8,0,0,0" Padding="14,0" Content="Übernehmen"
                        IsDefault="True" Click="OnSave" Style="{StaticResource SuccessButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
