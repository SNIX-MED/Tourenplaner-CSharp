<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.PinAddressInfoDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info zur Adresszuordnung" Width="840" Height="760" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Padding="18" Style="{StaticResource FlatCardStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Adresse prüfen und auswählen" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="OrderText" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Border Padding="12" Margin="0,0,0,12" Style="{StaticResource SoftCardStyle}">
                        <StackPanel>
                            <RadioButton x:Name="OriginalChoice" GroupName="Address" Content="Ursprüngliche Adresse behalten" IsChecked="True" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OriginalText" TextWrapping="Wrap" Margin="0,8"/>
                            <WrapPanel>
                                <Button Content="Google Maps" Tag="original" Click="Google_Click" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="TomTom" Tag="original" Click="TomTom_Click" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Adresse kopieren" Tag="original" Click="Copy_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0" Text="Ohne genauen Treffer bleibt die Warnung bestehen. Es wird kein abweichender Kartenpunkt übernommen." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="12" Margin="0,0,0,12" Style="{StaticResource SoftCardStyle}">
                        <StackPanel>
                            <RadioButton x:Name="FoundChoice" GroupName="Address" Content="Gefundene TomTom-Adresse verwenden" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FoundText" TextWrapping="Wrap" Margin="0,8"/>
                            <WrapPanel x:Name="FoundLinks">
                                <Button Content="Google Maps" Tag="found" Click="Google_Click" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="TomTom" Tag="found" Click="TomTom_Click" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Adresse kopieren" Tag="found" Click="Copy_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </WrapPanel>
                            <TextBlock x:Name="PositionText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Unterschiede im Detail" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="8,0,8,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Feld" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Ursprünglich" Margin="6,0" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="TomTom" Margin="6,0" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Vergleich" FontWeight="SemiBold"/>
                    </Grid>
                    <ItemsControl x:Name="Differences">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.BorderSoft}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Field}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Original}" Margin="6,0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Found}" Margin="6,0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Vergleich: ursprüngliche Adresse → TomTom-Treffer. Ein anderer Ortsname kann eine Gemeindebezeichnung sein. „Point Address“ bezeichnet einen Hausadress-Treffer, bestätigt aber nicht die Übereinstimmung mit dem Auftrag." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="Die Kartenlinks suchen nach der jeweiligen Adresse. Falls die Suche nicht übernommen wird, die Adresse kopieren und mit Strg+V in die Kartensuche einfügen." TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <CheckBox x:Name="ConfirmChoice" Margin="0,0,0,8">
                    <TextBlock Text="Ich habe die gefundene Adresse und Kartenposition geprüft." TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Auswahl übernehmen" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
