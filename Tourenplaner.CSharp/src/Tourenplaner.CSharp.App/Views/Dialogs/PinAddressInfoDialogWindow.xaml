<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.PinAddressInfoDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Kartenposition prüfen" Width="980" Height="760" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.WindowBackground}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Border Margin="12" Padding="18" Style="{StaticResource FlatCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Kartenposition prüfen" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="OrderText" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="OriginalText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="FoundText" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                        Content="Auftragsadresse in Google Maps" Click="Google_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
            <Border Grid.Row="2" CornerRadius="14" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="MapWebView" />
                    <Border x:Name="MapMessagePanel" Padding="18" Background="{DynamicResource Brush.SurfaceRaised}">
                        <TextBlock x:Name="MapMessageText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Kartenvorschau wird geladen …" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MapStyleButton" Content="Satellit" Click="MapStyle_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="MovePinButton" Margin="8,0,0,0" Content="Pin manuell platzieren" Click="MovePin_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0" Content="Pin zurücksetzen" Click="ResetPin_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,8,12,0" Orientation="Horizontal">
                    <TextBlock x:Name="PositionText" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                    <Border x:Name="PositionSourceBadge" Margin="10,0,0,0" Padding="7,3"
                            CornerRadius="7" Background="#18A00098" BorderBrush="#A00098" BorderThickness="1">
                        <TextBlock x:Name="PositionSourceText" Foreground="#800080" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="SaveButton" Content="Position übernehmen" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
