<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.UnavailabilityEditorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tourenplaner.CSharp.App.Views.Controls"
        Title="Abwesenheiten"
        Width="900"
        Height="480"
        MinWidth="760"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}">
    <Border Margin="12" Padding="18" CornerRadius="14" Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Abwesenheiten" />
            <TextBlock Margin="0,5,0,12" Foreground="{DynamicResource Brush.TextMuted}"
                       Text="Uhrzeiten sind optional. Ohne Uhrzeit gilt die Abwesenheit für den ganzen Tag." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Periods}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14" CornerRadius="10" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" /><ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="1.25*" /><ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Von Datum *" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontWeight="SemiBold" Text="Zeit" />
                                <TextBlock Grid.Column="2" Margin="14,0,0,0" FontWeight="SemiBold" Text="Bis Datum *" />
                                <TextBlock Grid.Column="3" Margin="10,0,0,0" FontWeight="SemiBold" Text="Zeit" />
                                <TextBlock Grid.Column="4" Margin="14,0,0,0" FontWeight="SemiBold" Text="Notiz" />
                                <controls:ModernDatePickerField Grid.Row="1" Margin="0,6,0,0" SelectedDateText="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Height="38" Margin="10,6,0,0" VerticalContentAlignment="Center"
                                         MaxLength="5" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Optional, HH:mm" PreviewTextInput="OnTimePreviewTextInput"
                                         DataObject.Pasting="OnTimePasting" />
                                <controls:ModernDatePickerField Grid.Row="1" Grid.Column="2" Margin="14,6,0,0" SelectedDateText="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="3" Height="38" Margin="10,6,0,0" VerticalContentAlignment="Center"
                                         MaxLength="5" Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Optional, HH:mm" PreviewTextInput="OnTimePreviewTextInput"
                                         DataObject.Pasting="OnTimePasting" />
                                <TextBox Grid.Row="1" Grid.Column="4" Height="38" Margin="14,6,0,0" VerticalContentAlignment="Center" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="1" Grid.Column="5" Width="34" Height="34" Margin="6,8,0,0" Padding="0" Content="×" FontSize="18" Tag="{Binding}" ToolTip="Abwesenheit entfernen" Style="{StaticResource DangerOutlineButtonStyle}" Click="OnRemoveRowClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Width="130" Height="38" Content="+ Hinzufügen" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddClicked" />
            <Button Grid.Column="2" Width="110" Height="38" Margin="0,0,8,0" Content="Abbrechen" Click="OnCancelClicked" />
            <Button Grid.Column="3" Width="110" Height="38" Content="Übernehmen" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClicked" />
        </Grid>
    </Grid>
    </Border>
</Window>
