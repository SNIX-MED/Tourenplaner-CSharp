<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.VehicleEditorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tourenplaner.CSharp.App.Views.Controls"
        Title="Fahrzeug"
        Width="540"
        Height="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Border Margin="10" Style="{StaticResource FlatCardStyle}" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock FontSize="34" FontWeight="Bold" Text="{Binding Heading}" />

                <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Typ" />
                <Border Margin="0,8,0,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.CardSoft}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="4"
                                Height="36"
                                Content="Zugfahrzeug"
                                Click="OnSetVehicleTypeClicked">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrailer}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1"
                                Margin="4"
                                Height="36"
                                Content="Anhänger"
                                Click="OnSetTrailerTypeClicked">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrailer}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Name" />
                <TextBox Margin="0,6,0,0" Height="38" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Kennzeichen" />
                <TextBox Margin="0,6,0,0" Height="38" Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Gesamtgewicht (kg)" />
                <TextBox Margin="0,6,0,0" Height="38" Text="{Binding GrossWeightKgText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Nutzlast (kg)" />
                <TextBox Margin="0,6,0,0" Height="38" Text="{Binding MaxPayloadKgText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Margin="0,14,0,0" Visibility="{Binding VehicleOnlyVisibility}">
                    <TextBlock FontWeight="SemiBold" Text="Anhängelast (kg)" />
                    <TextBox Margin="0,6,0,0" Height="38" Text="{Binding MaxTrailerLoadKgText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Volumen (m3)" />
                <TextBox Margin="0,6,0,0" Height="38" Text="{Binding VolumeM3Text, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Aussenmasse (L x B x H in m)" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,6,0" Height="38" Text="{Binding ExternalLengthMetersText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="6,0,6,0" Height="38" Text="{Binding ExternalWidthMetersText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="6,0,0,0" Height="38" Text="{Binding ExternalHeightMetersText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Ladefläche (L x B x H in m)" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,6,0" Height="38" Text="{Binding LengthMetersText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="6,0,6,0" Height="38" Text="{Binding WidthMetersText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="6,0,0,0" Height="38" Text="{Binding HeightMetersText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Notizen" />
                <TextBox Margin="0,6,0,0"
                         MinHeight="110"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Abwesenheiten / Ausfälle" />
                        <Button Grid.Column="1" Height="32" Padding="12,0" Content="Verwalten..." Click="OnManageAbsencesClicked" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid>
                        <TextBlock HorizontalAlignment="Center" Margin="8" Foreground="{DynamicResource Brush.TextMuted}" Text="Keine Abwesenheiten oder Ausfälle eingetragen">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UnavailabilityItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UnavailabilityItems}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Margin="0,0,0,5" Padding="10,8" CornerRadius="8"
                                            Background="White" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="4" Margin="0,1,10,1" CornerRadius="2" Background="#F97316" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DateRangeText}" />
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding TimeRangeText}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding NoteText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Grid>
                </StackPanel>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Width="110"
                            Height="40"
                            Margin="0,0,12,0"
                            Content="Löschen"
                            Style="{StaticResource DangerOutlineButtonStyle}"
                            Visibility="{Binding HasExistingEntry, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="OnDeleteClicked" />
                    <Button Grid.Column="2"
                            Width="120"
                            Height="40"
                            Margin="0,0,8,0"
                            Content="Abbrechen"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnCancelClicked" />
                    <Button Grid.Column="3"
                            Width="120"
                            Height="40"
                            Content="Speichern"
                            Style="{StaticResource SuccessButtonStyle}"
                            IsDefault="True"
                            Click="OnSaveClicked" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
