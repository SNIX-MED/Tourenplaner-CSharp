<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.LoadPlanPackageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Packstück" Width="520" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.WindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="Bold" Text="Packstück bearbeiten" />
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock FontWeight="SemiBold" Text="Bezeichnung *" /><TextBox x:Name="NameBox" Margin="0,6,0,0" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock FontWeight="SemiBold" Text="Packstücktyp" /><ComboBox x:Name="TypeBox" Margin="0,6,0,0" IsEditable="True"><ComboBoxItem Content="Palette"/><ComboBoxItem Content="Gitterbox"/><ComboBoxItem Content="Bündel"/><ComboBoxItem Content="Kiste"/></ComboBox></StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,18,0,0" FontWeight="SemiBold" Text="Manuelle Aussenmasse in mm" />
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Breite" />
                <Grid Height="38" Margin="0,5,0,0">
                    <TextBox x:Name="WidthBox" Padding="10,0,34,0" PreviewTextInput="OnNumericInput" />
                    <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}" Text="mm" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Tiefe" />
                <Grid Height="38" Margin="0,5,0,0">
                    <TextBox x:Name="DepthBox" Padding="10,0,34,0" PreviewTextInput="OnNumericInput" />
                    <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}" Text="mm" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Höhe (optional)" />
                <Grid Height="38" Margin="0,5,0,0">
                    <TextBox x:Name="HeightBox" Padding="10,0,34,0" PreviewTextInput="OnNumericInput" />
                    <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}" Text="mm" />
                </Grid>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="0,14,0,0" Foreground="#DC2626" TextWrapping="Wrap" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2" Content="Übernehmen" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
