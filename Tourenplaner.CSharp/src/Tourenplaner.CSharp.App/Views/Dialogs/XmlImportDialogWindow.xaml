<Window x:Class="Tourenplaner.CSharp.App.Views.Dialogs.XmlImportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sections="clr-namespace:Tourenplaner.CSharp.App.Views.Sections"
        Title="XML-Auftragsimport"
        Width="1380"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FlatCardStyle}" Padding="0" ClipToBounds="True">
            <sections:SettingsSectionView IsXmlImportOnlyMode="True" />
        </Border>

        <Button Grid.Row="1"
                Width="140"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Content="Schließen"
                IsCancel="True"
                Style="{StaticResource SecondaryButtonStyle}" />
    </Grid>
</Window>
