<Window x:Class="Tourenplaner.CSharp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:Tourenplaner.CSharp.App.Views.Components"
        xmlns:sections="clr-namespace:Tourenplaner.CSharp.App.Views.Sections"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        mc:Ignorable="d"
        Title="GAWELA Tourenplaner"
        Icon="Assets/Applogo.png"
        Width="1800"
        Height="1000"
        MinWidth="1220"
        MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <CollectionViewSource x:Key="SidebarNavigationItemsView"
                              Source="{Binding SidebarNavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="GroupName" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="16">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8FAFC" Offset="0" />
                <GradientStop Color="#EEF2FF" Offset="0.6" />
                <GradientStop Color="#F5F3FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Padding="14"
                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource FlatCardStyle}"
                    Background="{DynamicResource Brush.SidebarBackground}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Margin="0,2,0,10"
                            Padding="14"
                            CornerRadius="14"
                            Background="{DynamicResource Brush.SidebarHeaderBackground}"
                            BorderBrush="{DynamicResource Brush.BorderSoft}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="33" FontWeight="SemiBold" Text="GAWELA" />
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Brush.TextMuted}" Text="Tourenplaner" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="30"
                                    Height="56"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Padding="0"
                                    ToolTip="{Binding SidebarToggleToolTip}"
                                    Command="{Binding ToggleSidebarCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="{Binding SidebarToggleGlyph}" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <TextBlock Margin="4,8,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSubtle}" Text="(c) GAWELA" />
                    </StackPanel>

                    <ListBox x:Name="SidebarNavigationListBox"
                             Margin="0,2,0,0"
                             ItemsSource="{Binding Source={StaticResource SidebarNavigationItemsView}}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="SidebarNavigationListBox_PreviewMouseLeftButtonUp"
                             ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="6,12,6,4"
                                                   Style="{StaticResource SidebarSectionHeaderTextStyle}"
                                                   Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SidebarNavigationTextStyle}" Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Padding="5"
                    Visibility="{Binding IsCompactSidebarVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource FlatCardStyle}"
                    Background="{DynamicResource Brush.SidebarBackground}">
                <DockPanel>
                    <Button DockPanel.Dock="Top"
                            Width="42"
                            Height="42"
                            Margin="0,2,0,8"
                            Padding="0"
                            ToolTip="Seitenmenü einblenden"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="{Binding SidebarToggleGlyph}" />
                    </Button>

                    <ListBox x:Name="CompactSidebarNavigationListBox"
                             HorizontalContentAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding SidebarNavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="SidebarNavigationListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="40" />
                                <Setter Property="Height" Value="42" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CompactItemBorder"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource Brush.SidebarItemBackground}"
                                                    BorderBrush="{DynamicResource Brush.SidebarItemBorder}"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CompactItemBorder" Property="Background" Value="{DynamicResource Brush.SidebarItemHover}" />
                                                    <Setter TargetName="CompactItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CompactItemBorder" Property="Background" Value="{DynamicResource Brush.SidebarItemSelected}" />
                                                    <Setter TargetName="CompactItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.SidebarItemSelected}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="{Binding IconGlyph}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <components:DashboardTopBar Grid.Row="0" Margin="0,0,0,4" />

                <Border Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource FlatCardStyle}">
                            <Setter Property="Padding" Value="14" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsSectionActive}" Value="True">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="0" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMapSectionActive}" Value="True">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="0" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToursSectionActive}" Value="True">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="0" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <sections:KarteSectionView DataContext="{Binding MapSection}">
                            <sections:KarteSectionView.Style>
                                <Style TargetType="sections:KarteSectionView">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsMapSectionActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </sections:KarteSectionView.Style>
                        </sections:KarteSectionView>
                        <ContentControl Content="{Binding NonMapCurrentSection}"
                                        Style="{StaticResource SectionFadeInContentStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Popup x:Name="ToastPopup"
               IsOpen="{Binding IsToastVisible, Mode=OneWay}"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=RootGrid}"
               CustomPopupPlacementCallback="ToastPopup_Placement"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border Padding="16,14"
                    MinWidth="340"
                    MaxWidth="560"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent}"
                               Text="&#xE946;" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               Text="{Binding ToastMessage}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
